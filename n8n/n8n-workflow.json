{
  "name": "Alcovia - Focus Session Notification",
  "nodes": [
    {
      "parameters": { "httpMethod": "POST", "path": "focus-complete", "responseMode": "lastNode" },
      "id": "w", "name": "Webhook", "type": "n8n-nodes-base.webhook", "typeVersion": 2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "={{ 'http://localhost:3001/api/dedup-check?sessionId=' + $json.sessionId }}",
        "method": "GET"
      },
      "id": "d", "name": "Dedup Check", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4,
      "position": [500, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.alreadyNotified }}",
              "rightValue": false,
              "operator": { "type": "boolean", "operation": "equals" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "i", "name": "New?", "type": "n8n-nodes-base.if", "typeVersion": 2,
      "position": [750, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3001/api/notification-log",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "sessionId", "value": "={{ $('Webhook').first().json.sessionId }}" },
            { "name": "studentId", "value": "={{ $('Webhook').first().json.studentId }}" },
            { "name": "message", "value": "={{ 'Streak now ' + $('Webhook').first().json.streak + ' days, +' + $('Webhook').first().json.coins + ' coins' }}" }
          ]
        }
      },
      "id": "l", "name": "Log", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4,
      "position": [1000, 300]
    },
    {
      "parameters": {},
      "id": "s", "name": "Skip", "type": "n8n-nodes-base.noOp", "typeVersion": 1,
      "position": [1000, 500]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Dedup Check", "type": "main", "index": 0 }]] },
    "Dedup Check": { "main": [[{ "node": "New?", "type": "main", "index": 0 }]] },
    "New?": {
      "main": [
        [{ "node": "Log", "type": "main", "index": 0 }],
        [{ "node": "Skip", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "versionId": "6",
  "id": "alcovia-focus-notification",
  "active": true
}
