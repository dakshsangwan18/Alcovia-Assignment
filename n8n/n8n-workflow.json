{
  "name": "Alcovia - Focus Session Notification",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "focus-complete",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "http://localhost:3001/api/dedup-check",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            { "name": "sessionId", "value": "={{ $json.sessionId }}" }
          ]
        },
        "options": {}
      },
      "id": "dedup-check",
      "name": "Dedup Check",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [500, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-dedup",
              "leftValue": "={{ $json.alreadyNotified }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-dedup",
      "name": "Already Notified?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [750, 300]
    },
    {
      "parameters": {
        "url": "http://localhost:3001/api/notification-log",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "sessionId", "value": "={{ $('Webhook').item.json.sessionId }}" },
            { "name": "studentId", "value": "={{ $('Webhook').item.json.studentId }}" },
            { "name": "message", "value": "=Streak now {{ $('Webhook').item.json.streak }} days, +{{ $('Webhook').item.json.coins }} coins" }
          ]
        },
        "options": {}
      },
      "id": "send-notif",
      "name": "Send Notification",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1000, 300]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "noop",
      "name": "Noop",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [1000, 500]
    }
  ],
  "connections": {
    "Webhook": { "main": [[{ "node": "Dedup Check", "type": "main", "index": 0 }]] },
    "Dedup Check": { "main": [[{ "node": "Already Notified?", "type": "main", "index": 0 }]] },
    "Already Notified?": {
      "main": [
        [{ "node": "Send Notification", "type": "main", "index": 0 }],
        [{ "node": "Noop", "type": "main", "index": 0 }]
      ]
    },
    "Send Notification": { "main": [[{ "node": "Noop", "type": "main", "index": 0 }]] }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "versionId": "1",
  "id": "alcovia-focus-notification",
  "active": true
}
