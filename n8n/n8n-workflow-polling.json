{
  "name": "Alcovia - Focus Session Notification (Polling)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "seconds": 10
            }
          ]
        }
      },
      "id": "s", "name": "Schedule", "type": "n8n-nodes-base.scheduleTrigger", "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "url": "http://localhost:3001/api/notification-log",
        "method": "GET"
      },
      "id": "g", "name": "Get Log", "type": "n8n-nodes-base.httpRequest", "typeVersion": 4,
      "position": [500, 300]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const items = $input.all()[0].json;\nif (!Array.isArray(items)) return [];\nreturn items.map(item => ({ json: item }));"
      },
      "id": "c", "name": "Code", "type": "n8n-nodes-base.code", "typeVersion": 2,
      "position": [750, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "conditions": [
            {
              "leftValue": "={{ $json.sessionId }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "isNotEmpty" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "f", "name": "Valid?", "type": "n8n-nodes-base.if", "typeVersion": 2,
      "position": [1000, 300]
    },
    {
      "parameters": {},
      "id": "e", "name": "End", "type": "n8n-nodes-base.noOp", "typeVersion": 1,
      "position": [1250, 300]
    }
  ],
  "connections": {
    "Schedule": { "main": [[{ "node": "Get Log", "type": "main", "index": 0 }]] },
    "Get Log": { "main": [[{ "node": "Code", "type": "main", "index": 0 }]] },
    "Code": { "main": [[{ "node": "Valid?", "type": "main", "index": 0 }]] },
    "Valid?": {
      "main": [
        [{ "node": "End", "type": "main", "index": 0 }],
        []
      ]
    }
  },
  "settings": { "executionOrder": "v1" },
  "versionId": "1",
  "id": "alcovia-polling",
  "active": true
}
